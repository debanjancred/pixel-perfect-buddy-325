# Cloud mode (Supabase). Leave both empty to run fully on the device (the default).
# Values come from your Supabase project: Settings → API. The anon key is public by design;
# row-level security in supabase/migrations decides what each user can read and write.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase CLI only (migrations: docs/BACKEND.md section 2). Never VITE_-prefixed, never committed.
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
PROD_SUPABASE_REF=
PROD_SUPABASE_URL=
PROD_SUPABASE_ANON_KEY=
PROD_SUPABASE_DB_PASSWORD=
